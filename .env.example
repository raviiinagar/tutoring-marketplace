# Copy only for manual configuration. npm run setup:local creates unique local credentials.
NODE_ENV=development
DATABASE_URL=postgresql://tutoring_local:CHANGE_ME@127.0.0.1:5433/tutoring_dev
AUTH_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PORT=4000
MAIL_TRANSPORT=capture
DEV_MAIL_DIR=.local/mail
GUARDIAN_VERIFICATION_MODE=disabled
EVIDENCE_SCANNER=disabled
# For fictional local uploads only: test. Production scanning: clamav with private daemon.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Nonproduction only: test enables fictional Guardian/profile fixtures. Never enter real child data.
# Live production requires smtp, HTTPS origins, strong AUTH_SECRET, and secure cookies.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Checkout stays disabled until explicitly configured; see docs/api/payments.md.
PAYMENT_MODE=disabled
RAZORPAY_ACCOUNT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MERCHANT_NAME=
PAYMENT_INVOICE_NOTICE=
PAYMENT_BASE_PAISE=
PAYMENT_TAX_PAISE=
RAZORPAY_AUTO_CAPTURE_CONFIRMED=false
PAYMENT_LAUNCH_APPROVED=false

