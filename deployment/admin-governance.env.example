# Set through protected server configuration, never public UI variables.
# One existing active verified staff-account UUID; match OPERATIONS_OWNER_USER_ID.
STAFF_SUPER_ADMIN_USER_ID=
# Leave empty for mandatory MFA. Only explicitly named staging environments
# without live payments can use a UTC timestamp at most 72 hours ahead.
# Existing authenticators are retained; TEST_PASSWORD sessions end at cutoff.
STAFF_TEST_MFA_BYPASS_UNTIL=
