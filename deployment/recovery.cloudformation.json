{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Independent recovery bucket. Deploy only in the separately approved second region after data-location and full cost review.",
  "Parameters": {
    "Environment": {
      "Type": "String",
      "AllowedValues": ["staging", "production"]
    },
    "BucketName": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]"
    },
    "BackupWriterArn": {
      "Type": "String",
      "Description": "Existing dedicated IAM role ARN; keep its credentials outside the UI and recovery reader."
    },
    "RecoveryReaderArn": {
      "Type": "String",
      "Description": "Existing independently recoverable IAM role ARN, distinct from the application writer."
    }
  },
  "Resources": {
    "RecoveryBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": { "Ref": "BucketName" },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        },
        "VersioningConfiguration": { "Status": "Enabled" },
        "OwnershipControls": {
          "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExportRetention",
              "Status": "Enabled",
              "Prefix": "exports/",
              "ExpirationInDays": 14,
              "NoncurrentVersionExpiration": { "NoncurrentDays": 14 },
              "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
            },
            {
              "Id": "DeleteMarkerCleanup",
              "Status": "Enabled",
              "Prefix": "exports/",
              "ExpiredObjectDeleteMarker": true
            }
          ]
        }
      }
    },
    "RecoveryPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "RecoveryBucket" },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyPlaintextTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                { "Fn::GetAtt": ["RecoveryBucket", "Arn"] },
                { "Fn::Sub": "${RecoveryBucket.Arn}/*" }
              ],
              "Condition": { "Bool": { "aws:SecureTransport": "false" } }
            },
            {
              "Sid": "BackupObjects",
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "BackupWriterArn" } },
              "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion"],
              "Resource": [
                { "Fn::Sub": "${RecoveryBucket.Arn}/exports/${Environment}/*" },
                { "Fn::Sub": "${RecoveryBucket.Arn}/ledger/${Environment}/*" }
              ]
            },
            {
              "Sid": "NoRoutineBackupDeletion",
              "Effect": "Deny",
              "Principal": { "AWS": { "Ref": "BackupWriterArn" } },
              "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
              "Resource": { "Fn::Sub": "${RecoveryBucket.Arn}/*" }
            },
            {
              "Sid": "RecoveryRead",
              "Effect": "Allow",
              "Principal": { "AWS": { "Ref": "RecoveryReaderArn" } },
              "Action": ["s3:GetObject", "s3:GetObjectVersion"],
              "Resource": [
                { "Fn::Sub": "${RecoveryBucket.Arn}/exports/${Environment}/*" },
                { "Fn::Sub": "${RecoveryBucket.Arn}/ledger/${Environment}/*" }
              ]
            },
            {
              "Sid": "ListRecovery",
              "Effect": "Allow",
              "Principal": {
                "AWS": [
                  { "Ref": "RecoveryReaderArn" },
                  { "Ref": "BackupWriterArn" }
                ]
              },
              "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
              "Resource": { "Fn::GetAtt": ["RecoveryBucket", "Arn"] }
            }
          ]
        }
      }
    }
  },
  "Outputs": { "Bucket": { "Value": { "Ref": "RecoveryBucket" } } }
}
