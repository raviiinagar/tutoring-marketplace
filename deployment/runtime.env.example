# EXAMPLE ONLY. Provision this as /etc/tutoring/api.env (root:tutoring, 0640).
# Each environment gets separate credentials, database, ledger, keys and assets.
NODE_ENV=production
APP_ENVIRONMENT=staging
RELEASE_ID=REPLACE_WITH_REVIEWED_ARTIFACT_SHA
PORT=4000
WEB_ORIGIN=https://REPLACE_WITH_STAGING_HOST
ALLOWED_ORIGINS=https://REPLACE_WITH_STAGING_HOST
DATABASE_URL=postgres://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_PRIVATE_HOST:5432/REPLACE_STAGING_DATABASE?sslmode=verify-full&sslrootcert=/etc/tutoring/database-ca.pem
AUTH_SECRET=CHANGE_ME_TO_AN_INDEPENDENT_RANDOM_SECRET
MAIL_TRANSPORT=smtp
SMTP_HOST=REPLACE_WITH_VERIFIED_PROVIDER
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SEPARATE_ENVIRONMENT_CREDENTIAL
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER
GUARDIAN_VERIFICATION_MODE=disabled
EVIDENCE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Beta feedback and suggestion board (ADR0016). Off in production unless set to true.
BETA_FEEDBACK_ENABLED=false
# Beta community chat (ADR0017). Off in production unless set to true.
BETA_COMMUNITY_ENABLED=false
# Tutor photos wait for Trust approval before appearing (ADR0019). On in production unless set to false.
PHOTO_REVIEW_REQUIRED=true
# List only Tutors with an available ad in the public directory, and give no public profile
# page to a Tutor without one (ADR0021). Off unless set to true; the hosted site sets true.
DIRECTORY_REQUIRES_AD=false
# City-level map for a Tutor's "Your city" card in My Account. When true, the API looks each
# saved public city up once on OpenStreetMap Nominatim (no key; at most one request per second)
# and caches the coordinates in place_coordinates. Only the city is sent, never an address or
# account data. Off unless set to true. Optional: GEOCODING_URL, GEOCODING_USER_AGENT.
GEOCODING_ENABLED=false
# Public team contact in "Become a Tutor" reminder emails (ADR0023). Optional; without them the
# email links to /tutor, where "Send to our team" shows the configured channels.
# TEAM_WHATSAPP=918233598649
# TEAM_EMAIL=REPLACE_WITH_TEAM_ADDRESS
# Sign in with Google (ADR0020). Set both or neither. The secret belongs only in protected server configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to WEB_ORIGIN/v1/auth/google/callback and must match the Google client.
# GOOGLE_REDIRECT_URI=
PAYMENT_MODE=disabled
PRIVACY_RETENTION_POLICY_FILE=/etc/tutoring/approved-retention.json
PRIVACY_POLICY_APPROVED=false
PRIVACY_TOMBSTONE_DIR=/var/lib/tutoring/privacy-ledger
OPERATIONS_OWNER_USER_ID=REPLACE_WITH_VERIFIED_SCOPED_OWNER_UUID
# Recovery operator only: use a separately protected random 32-byte hex key.
BACKUP_KEY_FILE=/etc/tutoring/backup-key.hex
PG_RECOVERY_BIN=/usr/lib/postgresql/16/bin
APP_REGION=ap-south-1
RECOVERY_REGION=ap-southeast-1
RECOVERY_BUCKET=REPLACE_WITH_SEPARATE_ENVIRONMENT_BUCKET
RECOVERY_LOCATION_APPROVED=false
