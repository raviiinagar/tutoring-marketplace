# EXAMPLE ONLY. Provision this as /etc/tutoring/api.env (root:tutoring, 0640).
# Each environment gets separate credentials, database, ledger, keys and assets.
NODE_ENV=production
APP_ENVIRONMENT=staging
RELEASE_ID=REPLACE_WITH_REVIEWED_ARTIFACT_SHA
PORT=4000
WEB_ORIGIN=https://REPLACE_WITH_STAGING_HOST
ALLOWED_ORIGINS=https://REPLACE_WITH_STAGING_HOST
DATABASE_URL=postgres://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_PRIVATE_HOST:5432/REPLACE_STAGING_DATABASE?sslmode=verify-full&sslrootcert=/etc/tutoring/database-ca.pem
AUTH_SECRET=CHANGE_ME_TO_AN_INDEPENDENT_RANDOM_SECRET
MAIL_TRANSPORT=smtp
SMTP_HOST=REPLACE_WITH_VERIFIED_PROVIDER
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SEPARATE_ENVIRONMENT_CREDENTIAL
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER
GUARDIAN_VERIFICATION_MODE=disabled
EVIDENCE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
PAYMENT_MODE=disabled
PRIVACY_RETENTION_POLICY_FILE=/etc/tutoring/approved-retention.json
PRIVACY_POLICY_APPROVED=false
PRIVACY_TOMBSTONE_DIR=/var/lib/tutoring/privacy-ledger
OPERATIONS_OWNER_USER_ID=REPLACE_WITH_VERIFIED_SCOPED_OWNER_UUID
# Recovery operator only: use a separately protected random 32-byte hex key.
BACKUP_KEY_FILE=/etc/tutoring/backup-key.hex
PG_RECOVERY_BIN=/usr/lib/postgresql/16/bin
APP_REGION=ap-south-1
RECOVERY_REGION=ap-southeast-1
RECOVERY_BUCKET=REPLACE_WITH_SEPARATE_ENVIRONMENT_BUCKET
RECOVERY_LOCATION_APPROVED=false
