# Separate monitor host, region and read-only AWS credentials.
# No DATABASE_URL, AUTH_SECRET, backup decryption key or merchant secrets.
APP_ENVIRONMENT=production
RECOVERY_BUCKET=REPLACE_WITH_APPROVED_BUCKET
RECOVERY_REGION=ap-southeast-1
WATCHDOG_ORIGIN=https://REPLACE_WITH_PUBLIC_HOST
WATCHDOG_OWNER_EMAIL=REPLACE_WITH_VERIFIED_OWNER
WATCHDOG_OWNER_CONTACT_VERIFIED=false
WATCHDOG_SMTP_HOST=REPLACE_WITH_INDEPENDENT_VERIFIED_PROVIDER
WATCHDOG_SMTP_PORT=587
WATCHDOG_SMTP_USER=CHANGE_ME
WATCHDOG_SMTP_PASSWORD=CHANGE_ME
WATCHDOG_SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER
WATCHDOG_STATE_DIR=/var/lib/tutoring-watchdog
